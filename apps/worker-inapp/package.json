{
  "name": "@afrisinc-notify/worker-inapp",
  "version": "1.0.0",
  "description": "In-App notification worker service",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc --build",
    "dev": "tsx watch src/worker.ts",
    "start": "node dist/worker.js",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch --passWithNoTests",
    "test:coverage": "jest --coverage --passWithNoTests",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write 'src/**/*.ts'"
  },
  "dependencies": {
    "@afrisinc-notify/common": "workspace:*",
    "@afrisinc-notify/config": "workspace:*",
    "@afrisinc-notify/db": "workspace:*",
    "bull": "^4.11.5",
    "pino": "^8.17.2",
    "redis": "^4.6.12"
  },
  "devDependencies": {
    "@types/jest": "^29.5.10",
    "@types/node": "^20.10.6",
    "jest": "^29.7.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "keywords": [
    "notification",
    "in-app",
    "worker",
    "queue"
  ],
  "author": "Afrisinc",
  "license": "MIT"
}
