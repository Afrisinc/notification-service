{
  "name": "@afrisinc-notify/worker-inapp",
  "version": "1.0.0",
  "description": "In-App notification worker service",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "--- DEVELOPMENT ---": "",
    "dev": "tsx watch src/worker.ts",
    "--- BUILD ---": "",
    "build": "tsc --build",
    "--- RUNNING ---": "",
    "start": "node dist/worker.js",
    "start:prod": "NODE_ENV=production node dist/worker.js",
    "--- TESTING ---": "",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch --passWithNoTests",
    "test:coverage": "jest --coverage --passWithNoTests",
    "--- CODE QUALITY ---": "",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "--- PRE-COMMIT ---": "",
    "precommit": "npm run lint:fix && npm run format && npm run test"
  },
  "dependencies": {
    "@afrisinc-notify/common": "workspace:*",
    "@afrisinc-notify/config": "workspace:*",
    "@afrisinc-notify/db": "workspace:*",
    "@prisma/client": "^5.6.0",
    "bull": "^4.11.5",
    "pino": "^8.17.2",
    "redis": "^4.6.12"
  },
  "devDependencies": {
    "@types/jest": "^29.5.10",
    "@types/node": "^20.10.6",
    "jest": "^29.7.0",
    "prettier": "^3.1.1",
    "prisma": "^5.6.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "keywords": [
    "notification",
    "in-app",
    "worker",
    "queue"
  ],
  "author": "Afrisinc",
  "license": "MIT"
}
