{
  "name": "@afrisinc-notify/api",
  "version": "1.0.0",
  "description": "Notification Service API - Fastify HTTP server for managing notifications",
  "main": "dist/server.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "--- DEVELOPMENT ---": "",
    "dev": "tsx watch src/server.ts",
    "--- BUILD ---": "",
    "build": "tsc --build",
    "--- RUNNING ---": "",
    "start": "node dist/server.js",
    "start:prod": "NODE_ENV=production node dist/server.js",
    "--- TESTING ---": "",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch --passWithNoTests",
    "test:coverage": "jest --coverage --passWithNoTests",
    "--- CODE QUALITY ---": "",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "type-check": "tsc --noEmit",
    "--- PRE-COMMIT ---": "",
    "precommit": "npm run lint:fix && npm run format && npm run type-check"
  },
  "keywords": [
    "notification",
    "fastify",
    "api",
    "email",
    "sms",
    "microservice"
  ],
  "author": "Afrisinc Team",
  "license": "MIT",
  "dependencies": {
    "@afrisinc-notify/common": "workspace:*",
    "@afrisinc-notify/config": "workspace:*",
    "@afrisinc-notify/db": "workspace:*",
    "@fastify/cors": "^8.4.2",
    "@fastify/helmet": "^11.1.1",
    "@fastify/jwt": "^7.1.0",
    "@fastify/swagger": "^8.10.1",
    "@fastify/swagger-ui": "^1.10.1",
    "@prisma/client": "^5.6.0",
    "amqplib": "^0.10.3",
    "envalid": "^8.1.1",
    "fastify": "^4.25.1",
    "handlebars": "^4.7.8",
    "ioredis": "^5.3.2",
    "pino": "^8.17.2",
    "pino-pretty": "^10.3.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.4",
    "@types/jest": "^29.5.8",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.54.0",
    "jest": "^29.7.0",
    "prettier": "^3.1.0",
    "prisma": "^5.6.0",
    "ts-jest": "^29.1.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
