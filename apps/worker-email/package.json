{
  "name": "@afrisinc-notify/worker-email",
  "version": "1.0.0",
  "description": "Email notification worker service",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "--- DEVELOPMENT ---": "",
    "dev": "tsx watch src/index.ts",
    "--- BUILD ---": "",
    "build": "tsc --build",
    "--- RUNNING ---": "",
    "start": "node dist/index.js",
    "start:prod": "NODE_ENV=production node dist/index.js",
    "--- TESTING ---": "",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "--- CODE QUALITY ---": "",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "--- PRE-COMMIT ---": "",
    "precommit": "npm run lint:fix && npm run format && npm run test"
  },
  "dependencies": {
    "@afrisinc-notify/common": "workspace:*",
    "@afrisinc-notify/config": "workspace:*",
    "@afrisinc-notify/db": "workspace:*",
    "amqplib": "^0.10.3",
    "nodemailer": "^6.9.7",
    "@sendgrid/mail": "^7.7.0",
    "pino": "^8.17.2"
  },
  "devDependencies": {
    "@types/jest": "^29.5.10",
    "@types/node": "^20.10.6",
    "@types/nodemailer": "^6.4.14",
    "jest": "^29.7.0",
    "prettier": "^3.1.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "keywords": [
    "notification",
    "email",
    "worker",
    "queue"
  ],
  "author": "Afrisinc",
  "license": "MIT"
}
