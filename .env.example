# ============================================================================
# AFRISINC NOTIFICATION SERVICE - ENVIRONMENT VARIABLES
# ============================================================================
# Copy this file to .env and configure for your environment
# Do NOT commit .env to version control

# ============================================================================
# APPLICATION
# ============================================================================
NODE_ENV=development
APP_VERSION=1.0.0
LOG_LEVEL=debug

# ============================================================================
# API SERVER
# ============================================================================
API_PORT=3000
API_HOST=0.0.0.0
CORS_ORIGIN=*

# ============================================================================
# DATABASE - PostgreSQL
# ============================================================================
DATABASE_URL=postgresql://notification:password@localhost:5432/notification_db
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_CACHE_SIZE=25
DATABASE_TIMEOUT=30000

# ============================================================================
# REDIS - Caching and Sessions
# ============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://localhost:6379

# ============================================================================
# MESSAGE QUEUE
# ============================================================================
QUEUE_TYPE=bull
# For Bull (Redis-backed)
BULL_REDIS_URL=redis://localhost:6379/1
# For RabbitMQ
# RABBITMQ_URL=amqp://guest:guest@localhost:5672

# ============================================================================
# AUTHENTICATION
# ============================================================================
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRATION=24h
API_KEY_ENABLED=true

# ============================================================================
# EMAIL CONFIGURATION
# ============================================================================
EMAIL_PROVIDER=smtp
EMAIL_FROM=noreply@example.com

# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_TLS=true

# SendGrid Configuration (alternative)
# EMAIL_PROVIDER=sendgrid
# SENDGRID_API_KEY=SG.xxx

# AWS SES Configuration (alternative)
# EMAIL_PROVIDER=aws-ses
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=xxx
# AWS_SECRET_ACCESS_KEY=xxx

# ============================================================================
# SMS CONFIGURATION
# ============================================================================
SMS_PROVIDER=twilio

# Twilio Configuration
TWILIO_ACCOUNT_SID=your-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_FROM_NUMBER=+1234567890

# AfricasTalking Configuration (alternative)
# SMS_PROVIDER=africastalking
# AFRICASTALKING_API_KEY=xxx
# AFRICASTALKING_USERNAME=xxx
# AFRICASTALKING_FROM_NAME=xxx

# ============================================================================
# EXTERNAL SERVICES
# ============================================================================
# Sentry - Error Tracking
# SENTRY_DSN=https://xxx@sentry.io/xxx

# Datadog - Monitoring
# DATADOG_API_KEY=xxx

# Jaeger - Distributed Tracing
# JAEGER_ENDPOINT=http://localhost:14268/api/traces

# ============================================================================
# FEATURE FLAGS
# ============================================================================
ENABLE_LOGGING=true
ENABLE_TRACING=false
ENABLE_METRICS=true
ENABLE_HEALTH_CHECKS=true

# ============================================================================
# RATE LIMITING
# ============================================================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================================================
# RETRY AND BACKOFF
# ============================================================================
MAX_RETRIES=3
RETRY_BACKOFF_INITIAL=1000
RETRY_BACKOFF_MAX=60000
RETRY_BACKOFF_MULTIPLIER=2

# ============================================================================
# TIMEOUTS (milliseconds)
# ============================================================================
HTTP_TIMEOUT=30000
EXTERNAL_API_TIMEOUT=10000
WORKER_TIMEOUT=60000

# ============================================================================
# NOTES
# ============================================================================
# - Never commit .env to version control
# - Use different values for each environment (dev, staging, prod)
# - Keep sensitive values in secrets manager (Vault, AWS Secrets Manager, etc.)
# - Update JWT_SECRET, TWILIO credentials, SendGrid API keys, etc. in production
# - Use strong passwords for SMTP, database, and other services
