############################################################
# ENVIRONMENT CONFIGURATION
############################################################
NODE_ENV=development
APP_ENV=development

############################################################
# DATABASE - DEVELOPMENT (Read/Write Separation)
############################################################

# Write Database (Primary/Master)
DEV_WRITE_DB_DIALECT=postgresql
DEV_WRITE_DB_HOST=localhost
DEV_WRITE_DB_PORT=5432
DEV_WRITE_DB_USER=postgres
DEV_WRITE_DB_PASS=postgres
DEV_WRITE_DB_NAME=notification_service_write

# Read Database (Replica/Read-Only)
DEV_READ_DB_DIALECT=postgresql
DEV_READ_DB_HOST=localhost
DEV_READ_DB_PORT=5432
DEV_READ_DB_USER=postgres
DEV_READ_DB_PASS=postgres
DEV_READ_DB_NAME=notification_service_read

############################################################
# DATABASE - PRODUCTION (Read/Write Separation)
############################################################

# Write Database (Primary/Master)
PDN_WRITE_DB_DIALECT=postgresql
PDN_WRITE_DB_HOST=db-primary.example.com
PDN_WRITE_DB_PORT=5432
PDN_WRITE_DB_USER=produser
PDN_WRITE_DB_PASS=secure_password_here
PDN_WRITE_DB_NAME=notification_service_prod

# Read Database (Replica/Read-Only)
PDN_READ_DB_DIALECT=postgresql
PDN_READ_DB_HOST=db-replica.example.com
PDN_READ_DB_PORT=5432
PDN_READ_DB_USER=produser_readonly
PDN_READ_DB_PASS=secure_password_here
PDN_READ_DB_NAME=notification_service_prod

############################################################
# AUTHENTICATION & JWT
############################################################
AUTH_TOKEN=your-secret-jwt-key-here-change-in-production
TOKEN_LIFE=1h
PRIVATE_KEY=your-private-key-for-encryption

############################################################
# RABBITMQ (Message Queue)
############################################################
RABBIT_PROTOCOL=amqp
RABBIT_SERVER=localhost
RABBIT_PORT=5672
RABBIT_USERNAME=guest
RABBIT_PASSWORD=guest
RABBIT_VHOST=/

HOST=0.0.0.0
PORT=8010

############################################################
# EMAIL SERVICE (SendGrid)
############################################################
SENDGRID_API_KEY=your-sendgrid-api-key-here
SENDGRID_FROM_EMAIL=noreply@example.com

############################################################
# SMS SERVICE (AfricasTalking)
############################################################
AFRICAS_TALKING_API_KEY=your-africas-talking-api-key
AFRICAS_TALKING_USERNAME=your-africas-talking-username

############################################################
# LOGGING
############################################################
LOG_LEVEL=debug
