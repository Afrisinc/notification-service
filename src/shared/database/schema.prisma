////////////////////////////////////////////////////////////
// GENERATOR & DATASOURCE
////////////////////////////////////////////////////////////

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

////////////////////////////////////////////////////////////
// ==================== ENUMS ====================
////////////////////////////////////////////////////////////

// Tenant Status
enum TenantStatus {
  ACTIVE
  SUSPENDED
}

// Notification Channel Types
enum Channel {
  EMAIL
  SMS
  IN_APP
  PUSH
  WHATSAPP
}

// Notification Delivery Status
enum NotificationStatus {
  PENDING
  QUEUED
  SENT
  FAILED
}

// Notification Priority Levels
enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

// Template Category for Organization
enum TemplateCategory {
  AUTH
  TRANSACTIONAL
  MARKETING
  NOTIFICATION
}

// Account Type (User or Organization)
enum AccountType {
  INDIVIDUAL
  ORGANIZATION
}

// User Status
enum UserStatus {
  ACTIVE
  INACTIVE
  DORMANT
  CLOSED
  SUSPENDED
}

// Product Status
enum ProductStatus {
  PROVISIONING
  ACTIVE
  SUSPENDED
}

// Product Plan
enum ProductPlan {
  FREE
  PRO
  ENTERPRISE
}

// Organization Member Role
enum OrganizationMemberRole {
  OWNER
  ADMIN
  MEMBER
}

////////////////////////////////////////////////////////////
// ==================== MODELS ====================
////////////////////////////////////////////////////////////
// Models are kept separate in src/shared/database/models/
// Run 'pnpm run db:build-schema' to consolidate them
// This file is used by Prisma to generate the client
