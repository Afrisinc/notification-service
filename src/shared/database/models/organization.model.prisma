////////////////////////////////////////////////////////////
// DOMAIN: ORGANIZATIONS
// Organization account management
////////////////////////////////////////////////////////////

model Organization {
  id                String    @id @default(uuid())
  name              String
  slug              String?   @unique
  legal_name        String?
  country           String?
  tax_id            String?
  org_email         String?
  org_phone         String?
  location          String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Org-level Cloudflare default: used to auto-configure DNS for any domain
  // added under this organization when no per-domain token is supplied
  // (see OrgDomainService.addDomain). Encrypted the same way as the
  // per-domain fallback on EmailDomain.
  cloudflare_api_token   String?  // encrypted
  cloudflare_connected   Boolean  @default(false)

  // Relations
  members           OrganizationMember[]
  invites           OrganizationInvite[] @relation("OrganizationInvites")
  accounts          Account[]
  apps              App[]
  emailDomains      EmailDomain[]
  emailThreads      EmailThread[]

  @@map("organizations")
}
