model EmailDomain {
  id                     String                @id @default(uuid())
  app_id                 String?
  organization_id        String?
  domain                 String
  selector               String                @default("afrisinc")
  dkim_public_key        String?
  dkim_private_key_path  String?
  status                 CustomerDomainStatus  @default(pending)
  spf_verified           Boolean               @default(false)
  dkim_verified          Boolean               @default(false)
  dmarc_verified         Boolean               @default(false)
  verified_at            DateTime?

  // Cloudflare-assisted DNS setup (optional - falls back to manual DNS records)
  cloudflare_zone_id     String?
  cloudflare_api_token   String?               // encrypted
  cloudflare_connected   Boolean               @default(false)

  // Inbound receiving (opt-in, independent of outbound send verification above)
  inbound_enabled        Boolean               @default(false)
  mx_verified            Boolean               @default(false)
  mx_verified_at         DateTime?

  created_at             DateTime              @default(now())
  updated_at             DateTime              @updatedAt

  // Relations
  app                    App?                  @relation(fields: [app_id], references: [id], onDelete: Cascade)
  organization           Organization?         @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  senders                EmailSender[]
  threads                EmailThread[]

  // A domain belongs either to a single App (legacy per-app flow) or to an
  // Organization directly (org-level flow) - never enforced as XOR at the DB
  // level, but every write path only ever sets one or the other. Two unique
  // constraints coexist safely since Postgres treats NULLs as distinct.
  @@unique([app_id, domain])
  @@unique([organization_id, domain])
  @@index([app_id])
  @@index([organization_id])
  @@map("email_domains")
}

model EmailSender {
  id               String       @id @default(uuid())
  domain_id        String
  local_part       String
  from_name        String?
  reply_to_email   String?
  reply_to_name    String?
  is_default       Boolean      @default(false)
  is_active        Boolean      @default(true)

  // Org-level flow only: which member this address belongs to. Null for
  // legacy per-app senders, and optionally null for an org sender any
  // OWNER/ADMIN can use (not assigned to one specific person).
  assigned_user_id String?

  created_at       DateTime     @default(now())
  updated_at       DateTime     @updatedAt

  // Relations
  domain           EmailDomain  @relation(fields: [domain_id], references: [id], onDelete: Cascade)
  assignedUser     User?        @relation(fields: [assigned_user_id], references: [id], onDelete: SetNull)

  @@unique([domain_id, local_part])
  @@index([domain_id])
  @@index([assigned_user_id])
  @@map("email_senders")
}
