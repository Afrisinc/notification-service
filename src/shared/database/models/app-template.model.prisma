////////////////////////////////////////////////////////////
// DOMAIN: APPS & TEMPLATES
// Template installations on applications
////////////////////////////////////////////////////////////

model AppTemplate {
  id                String   @id @default(uuid())
  app_id            String
  template_id       String
  customizations    Json?
  design_json       Json?             // App-specific design overrides and customizations
  editor_type       EditorType?       // Override template editor type for this app (optional)
  status            String   @default("active") // active | archived | disabled
  installationDate  DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  app               App      @relation(fields: [app_id], references: [id], onDelete: Cascade)
  template          Template @relation(fields: [template_id], references: [id], onDelete: Cascade)

  @@unique([app_id, template_id])
  @@index([app_id])
  @@index([template_id])
  @@map("app_templates")
}
