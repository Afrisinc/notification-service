////////////////////////////////////////////////////////////
// DOMAIN: TEMPLATES
// Email/notification templates with versioning
////////////////////////////////////////////////////////////

model Template {
  id                String            @id @default(uuid())
  account_id        String
  created_by_user_id String
  code              String
  channel           Channel
  category          TemplateCategory  @default(TRANSACTIONAL)
  subject           String?
  content           String
  language          String            @default("en")
  version           Int               @default(1)
  active            Boolean           @default(true)
  requiredVariables Json?
  design_json       Json?             // Template design configuration (layout, styling, blocks, etc.)
  editor_type       EditorType        @default(visual) // visual (drag-drop) or code (HTML only)
  description       String?
  visibility        TemplateVisibility            @default(private) // private | account | marketplace
  is_public         Boolean           @default(false)
  pricing           TemplatePricing   @default(free) // free | paid
  price             Float?            // Price in cents for marketplace templates
  currency          Currency            @default(USD) // Currency code

  // Marketplace fields
  thumbnail         String?           // Thumbnail image URL
  previewUrl        String?           // Preview/demo URL
  screenshots       String[]          @default([]) // Array of screenshot URLs
  tags              String[]          @default([]) // Tags for discoverability
  estimatedDeliveryTime String?       // e.g., "< 1 second"
  compatibility     Json?             // Provider compatibility (Sendgrid, Mailgun, Twilio, etc.)

  // Marketplace metrics
  rating            Float?            @default(0) // Average rating 0-5
  ratingCount       Int               @default(0) // Total number of ratings
  installs          Int               @default(0) // Total installations
  relatedTemplates  String[]          @default([]) // IDs of related templates

  // Changelog
  changelog         Json?             // Array of version changes

  deletedAt         DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  // Relations
  account           Account           @relation(fields: [account_id], references: [id], onDelete: Cascade)
  createdBy         User              @relation("CreatedBy", fields: [created_by_user_id], references: [id], onDelete: Restrict)
  versions          TemplateVersion[]
  appTemplates      AppTemplate[]
  campaigns         Campaign[]
  reviews           TemplateReview[]

  @@unique([account_id, code, channel, language])
  @@index([account_id, active])
  @@index([account_id, category])
  @@index([account_id, code, channel, active])
  @@index([account_id, deletedAt])
  @@index([visibility, is_public, active]) // For marketplace filtering
  @@map("templates")
}
