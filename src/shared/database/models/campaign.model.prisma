////////////////////////////////////////////////////////////
// DOMAIN: CAMPAIGNS
// Campaign management and performance tracking
////////////////////////////////////////////////////////////

enum CampaignStatus {
  draft
  scheduled
  sending
  completed
  cancelled
}

model Campaign {
  id                    String           @id @default(uuid())
  app_id                String
  name                  String
  channel               Channel
  template_id           String?          // Optional: use template OR direct content

  // ═══════════════════════════════════════════════════════════
  // DIRECT CONTENT MODE - Channel-specific fields
  // Only one set of fields should be used based on channel
  // ═══════════════════════════════════════════════════════════

  // EMAIL channel content
  subject               String?          // Email subject line
  html_content          String?          // Email HTML body

  // SMS channel content
  text_content          String?          // SMS text message (max ~160 chars per segment)

  // PUSH channel content
  push_title            String?          // Push notification title
  push_body             String?          // Push notification body
  push_image_url        String?          // Optional image URL for rich push
  push_action_url       String?          // URL to open when push is tapped
  push_data             Json?            // Custom data payload for push

  // IN_APP channel content
  inapp_title           String?          // In-app notification title
  inapp_body            String?          // In-app notification body
  inapp_image_url       String?          // Optional image URL
  inapp_action_url      String?          // Action URL when clicked
  inapp_action_text     String?          // Call-to-action button text

  // ═══════════════════════════════════════════════════════════
  // RECIPIENT TARGETING
  // ═══════════════════════════════════════════════════════════
  recipient_type        String           @default("all") // all, tags, segment, custom
  recipient_count       Int              @default(0)
  recipient_tags        String[]         @default([])
  recipient_segment     String?
  status                CampaignStatus   @default(draft)
  sent_count            Int              @default(0)
  delivered_count       Int              @default(0)
  failed_count          Int              @default(0)
  bounce_count          Int              @default(0)
  open_count            Int              @default(0)
  click_count           Int              @default(0)
  conversion_count      Int              @default(0)
  unsubscribe_count     Int              @default(0)
  scheduled_at          DateTime?
  sent_at               DateTime?
  completed_at          DateTime?
  metadata              Json?            @default("{}")
  created_by_user_id    String?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  // Relations
  app                   App              @relation(fields: [app_id], references: [id], onDelete: Cascade)
  template              Template?        @relation(fields: [template_id], references: [id], onDelete: Restrict)
  createdByUser         User?            @relation("CreatedByCampaign", fields: [created_by_user_id], references: [id], onDelete: SetNull)

  @@unique([app_id, name])
  @@index([app_id])
  @@index([status])
  @@index([channel])
  @@index([scheduled_at])
  @@index([createdAt])
  @@map("campaigns")
}
