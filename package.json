{
  "name": "afrisinc-notification-service",
  "version": "1.0.0",
  "description": "Unified notification service with API and workers",
  "main": "dist/services/api/src/server.js",
  "type": "commonjs",
  "scripts": {
    "--- SETUP ---": "",
    "prepare": "husky install || true",
    "--- DATABASE ---": "",
    "db:generate": "npx prisma generate",
    "db:migrate": "npx prisma migrate dev",
    "db:migrate:prod": "npx prisma migrate deploy",
    "db:push": "npx prisma db push",
    "db:studio": "npx prisma studio",
    "db:seed": "tsx src/shared/database/seeds/users.seed.ts",
    "db:setup": "npx prisma db push && pnpm db:seed",
    "--- BUILD ---": "",
    "build": "tsc --build",
    "build:watch": "tsc --build --watch",
    "clean": "rimraf dist",
    "--- DEVELOPMENT ---": "",
    "dev": "tsx watch src/services/api/src/server.ts",
    "dev:api": "tsx watch src/services/api/src/server.ts",
    "dev:worker-email": "tsx watch src/services/worker-email/src/index.ts",
    "dev:worker-sms": "tsx watch src/services/worker-sms/src/index.ts",
    "dev:worker-inapp": "tsx watch src/services/worker-inapp/src/index.ts",
    "dev:all": "concurrently \"pnpm dev:api\" \"pnpm dev:worker-email\" \"pnpm dev:worker-sms\" \"pnpm dev:worker-inapp\"",
    "--- PRODUCTION ---": "",
    "start": "node -r ./register-paths.js dist/services/api/src/server.js",
    "start:api": "cross-env NODE_ENV=production node -r ./register-paths.js dist/services/api/src/server.js",
    "start:worker-email": "cross-env NODE_ENV=production node -r ./register-paths.js dist/services/worker-email/src/index.js",
    "start:worker-sms": "cross-env NODE_ENV=production node -r ./register-paths.js dist/services/worker-sms/src/index.js",
    "start:worker-inapp": "cross-env NODE_ENV=production node -r ./register-paths.js dist/services/worker-inapp/src/index.js",
    "--- TESTING ---": "",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "--- CODE QUALITY ---": "",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^8.4.2",
    "@fastify/helmet": "^11.1.1",
    "@fastify/jwt": "^7.1.0",
    "@fastify/swagger": "^8.10.1",
    "@fastify/swagger-ui": "^1.10.1",
    "@prisma/client": "^5.6.0",
    "@sendgrid/mail": "^7.7.0",
    "africastalking": "^0.7.8",
    "amqplib": "^0.10.3",
    "bcryptjs": "^3.0.3",
    "bull": "^4.11.5",
    "dotenv": "^16.3.1",
    "envalid": "^8.1.1",
    "fastify": "^4.25.1",
    "handlebars": "^4.7.8",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "jwt-decode": "^4.0.0",
    "nodemailer": "^6.9.7",
    "pino": "^8.17.2",
    "pino-pretty": "^10.3.1",
    "redis": "^4.6.12",
    "tsconfig-paths": "^4.2.0",
    "twilio": "^4.10.0",
    "uuid": "^13.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.4",
    "@types/jest": "^29.5.10",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/node": "^20.10.6",
    "@types/nodemailer": "^6.4.14",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "eslint": "^8.54.0",
    "husky": "^8.0.3",
    "jest": "^29.7.0",
    "lint-staged": "^15.2.0",
    "prettier": "^3.1.1",
    "prisma": "^5.6.0",
    "rimraf": "^5.0.5",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "keywords": [
    "notification",
    "api",
    "email",
    "sms",
    "microservice"
  ],
  "author": "Afrisinc Team",
  "license": "MIT",
  "prisma": {
    "schema": "src/shared/database/models",
    "seed": "tsx src/shared/database/seeds/users.seed.ts"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
