{
  "name": "afrisinc-notify",
  "version": "1.0.0",
  "description": "Production-ready notification service monorepo - Email, SMS, In-App notifications with Fastify, TypeScript, and Prisma",
  "homepage": "https://github.com/afrisinc/notification-service",
  "repository": {
    "type": "git",
    "url": "https://github.com/afrisinc/notification-service.git"
  },
  "bugs": {
    "url": "https://github.com/afrisinc/notification-service/issues"
  },
  "author": {
    "name": "Afrisinc Engineering",
    "email": "info@afrisinc.com",
    "url": "https://afrisinc.com"
  },
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "--- DEVELOPMENT ---": "",
    "dev": "pnpm run dev -ws",
    "dev:api": "pnpm run dev -w @afrisinc-notify/api",
    "dev:workers": "pnpm run dev -w @afrisinc-notify/worker-email & pnpm run dev -w @afrisinc-notify/worker-sms & pnpm run dev -w @afrisinc-notify/worker-inapp",
    "dev:worker:email": "pnpm run dev -w @afrisinc-notify/worker-email",
    "dev:worker:sms": "pnpm run dev -w @afrisinc-notify/worker-sms",
    "dev:worker:inapp": "pnpm run dev -w @afrisinc-notify/worker-inapp",
    "--- BUILD & TYPE CHECK ---": "",
    "build": "pnpm run build -ws",
    "build:api": "pnpm run build -w @afrisinc-notify/api",
    "type-check": "pnpm run type-check -ws",
    "--- TESTING ---": "",
    "test": "pnpm test -ws -- --passWithNoTests",
    "test:watch": "pnpm run test:watch -ws -- --passWithNoTests",
    "test:coverage": "pnpm run test:coverage -ws -- --passWithNoTests",
    "--- CODE QUALITY ---": "",
    "lint": "pnpm run lint -ws",
    "lint:fix": "pnpm run lint:fix -ws",
    "format": "pnpm run format -ws",
    "format:check": "pnpm run format:check -ws",
    "--- DATABASE ---": "",
    "db:generate": "pnpm run generate -w @afrisinc-notify/db",
    "db:migrate": "pnpm run migrate -w @afrisinc-notify/db",
    "db:migrate:prod": "pnpm run migrate:prod -w @afrisinc-notify/db",
    "db:seed": "pnpm run seed -w @afrisinc-notify/db",
    "db:push": "prisma db push --schema=./packages/db/prisma/schema.prisma",
    "db:reset": "prisma migrate reset --schema=./packages/db/prisma/schema.prisma",
    "db:studio": "pnpm run studio -w @afrisinc-notify/db",
    "db:deploy": "pnpm run migrate:prod -w @afrisinc-notify/db && pnpm run seed -w @afrisinc-notify/db",
    "--- GIT OPERATIONS ---": "",
    "git:status": "git status",
    "git:add": "git add .",
    "git:commit": "git commit",
    "git:push": "git push",
    "git:pull": "git pull",
    "git:log": "git log --oneline -10",
    "git:branch": "git branch -a",
    "--- QUEUE MANAGEMENT ---": "",
    "queue:status": "tsx scripts/queue-status.ts",
    "queue:replay-dlq": "tsx scripts/replay-dlq.ts",
    "queue:clear": "tsx scripts/queue-clear.ts",
    "--- DOCKER ---": "",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:restart": "docker-compose restart",
    "--- PRODUCTION ---": "",
    "start": "pnpm start -ws",
    "start:api": "pnpm start -w @afrisinc-notify/api",
    "start:workers": "pnpm start -w @afrisinc-notify/worker-email & pnpm start -w @afrisinc-notify/worker-sms & pnpm start -w @afrisinc-notify/worker-inapp",
    "--- UTILITIES ---": "",
    "clean": "rimraf dist node_modules && pnpm install",
    "reinstall": "pnpm run clean",
    "precommit": "pnpm run lint:fix && pnpm run format && pnpm run type-check",
    "prepare": "pnpm run db:generate"
  },
  "keywords": [
    "notification",
    "email",
    "sms",
    "in-app",
    "fastify",
    "postgresql",
    "monorepo",
    "microservices",
    "production-ready"
  ],
  "devDependencies": {
    "@types/node": "^20.10.0",
    "prettier": "^3.1.1",
    "rimraf": "^5.0.5",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "dotenv": "^17.2.4"
  }
}
